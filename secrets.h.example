// secrets.h.example
// Copy this file to "secrets.h" (in the same folder as the .ino) and fill in
// your own values. secrets.h is listed in .gitignore and must never be committed.

#pragma once

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Network name used for Arduino OTA uploads (shows up as a network port in the IDE)
#define OTA_HOSTNAME  "djoOneStrandPico"
// Password the Arduino IDE will prompt for when uploading over the network
#define OTA_PASSWORD  "change-me"
